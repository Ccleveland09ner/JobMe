# Supabase (starter)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Starter only. JobMe never uses this - every route goes through RLS with the
# cookie-based server client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini: scoring, follow-up drafting, embeddings. Server-side only.
GEMINI_API_KEY=
# Verify the current fast-model ID in hour 1, and keep "thinking" off - the
# 1.5s turn budget depends on it. (Open Question #2)
LLM_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# TTS. Use `browser` while developing to stay inside the free tier; switch to
# `elevenlabs` for demo takes only. One session is roughly 1.5k characters.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
