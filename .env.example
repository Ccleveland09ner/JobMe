# Supabase (starter)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed the "anon key" to the "publishable key" - the dashboard now
# gives you the latter. Either name works; this one is preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy name, still accepted
# Starter only. JobMe never uses this - every route goes through RLS with the
# cookie-based server client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini: scoring, follow-up drafting, embeddings. Server-side only.
GEMINI_API_KEY=
# gemini-2.5-flash is NOT available to new projects (restricted 2026-09-18).
# Thinking cannot be turned off on Gemini 3; `minimal` is the floor, and it is
# already the default on flash-lite - which is why this tier is the default.
# Free-tier rate limits are no longer published: read yours at
# https://aistudio.google.com/rate-limit before a rehearsal.
LLM_MODEL=gemini-3.5-flash-lite
# NOT gemini-embedding-2 - it aggregates multiple inputs into one vector and
# dropped taskType. See src/lib/ai/llm.ts.
EMBED_MODEL=gemini-embedding-001
# generateContent | interactions. Legacy is the default on purpose - the
# Interactions API's JS casing for thinking_level is ambiguous in the docs.
LLM_SURFACE=generateContent

# TTS. Use `browser` while developing to stay inside the free tier; switch to
# `elevenlabs` for demo takes only. One session is roughly 1.5k characters.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
