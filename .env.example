# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Supabase renamed its API keys: "anon key" is now the PUBLISHABLE key, and
# "service_role key" is now the SECRET key. Both new names are used below.
#
# The URL and publishable key carry the NEXT_PUBLIC_ prefix because the sign-in
# form runs in the browser (src/app/login/login-form.tsx), and Next.js only
# inlines NEXT_PUBLIC_* variables into the client bundle. Without the prefix
# the browser client resolves to undefined at runtime.
#
# The unprefixed SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY are also accepted, but
# only on the server — see src/lib/supabase/env.ts.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security entirely.
# JobMe does NOT use this: every route goes through RLS with the cookie-based
# server client. Kept because the starter references it.
SUPABASE_SECRET_KEY=

# Optional. The JSON Web Key Set for this project, used to verify a session
# JWT locally instead of calling Supabase over the network.
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Not wired up yet — see src/lib/auth.ts, which currently uses getUser().
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Gemini — scoring, follow-up drafting, embeddings. Server-side only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# gemini-2.5-flash is NOT available to new projects (restricted 2026-09-18).
# Thinking cannot be turned off on Gemini 3; this tier reports zero thought
# tokens with no thinking config at all, and is the fastest of the options.
# Measured table: src/lib/ai/llm.ts
LLM_MODEL=gemini-3.5-flash-lite

# NOT gemini-embedding-2 — it aggregates multiple inputs into a single vector
# and dropped taskType, both of which break chunked retrieval silently.
EMBED_MODEL=gemini-embedding-001

# generateContent | interactions
# Legacy is the default deliberately: @google/genai 2.24 exposes no
# `interactions` namespace at all.
LLM_SURFACE=generateContent

# Free tier is 15 requests per minute, per model (measured). Read your own
# limits at https://aistudio.google.com/rate-limit

# ---------------------------------------------------------------------------
# ElevenLabs — the recruiter's voice. Server-side only.
# ---------------------------------------------------------------------------
# Leave TTS_PROVIDER=browser while developing: free tier is ~10k characters a
# month and one interview is roughly 1.5k. Switch to elevenlabs for demo takes.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
